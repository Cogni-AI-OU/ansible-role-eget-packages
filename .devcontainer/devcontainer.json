// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
  "containerEnv": {
    "DEBIAN_FRONTEND": "noninteractive",
    "EGET_CONFIG": "${containerWorkspaceFolder}/.devcontainer/.eget.toml",
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}"
  },

  // Configure tool-specific properties.
  // Note: Keep the list in alphabetical order.
  "customizations": {
    "vscode": {
      "extensions": [
        "bierner.markdown-mermaid",
        "DavidAnson.vscode-markdownlint",
        "elagil.pre-commit-helper",
        "formulahendry.code-runner",
        "formulahendry.code-runner-copilot",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-github-actions",
        "ms-python.python",
        "vscodevim.vim",
        "vsls-contrib.codetour",
        "xaver.clang-format"
      ]
    }
  },
  // Features to add to the dev container. More info: https://containers.dev/features.
  "features": {
    "ghcr.io/devcontainers-extra/features/actionlint:1": {},
    "ghcr.io/devcontainers-extra/features/eget:1": { "version": "1.3.4" },
    "ghcr.io/devcontainers-extra/features/node-asdf:0": { "version": "22.23.3" },
    "ghcr.io/devcontainers-extra/features/pipx-package:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/python:1": {},
    "ghcr.io/guiyomh/features/vim:0": {},
    "ghcr.io/jungaretti/features/make:1": {},
    "ghcr.io/jungaretti/features/ripgrep:1": {},
    "ghcr.io/sliekens/devcontainer-features/opencode:1": {}
  },

  // Pre-create opencode directories on host before container starts (required for bind mounts)
  "initializeCommand": "mkdir -p \"$HOME/.local/share/opencode\" \"$HOME/.config/opencode\"",

  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/base:jammy",
  "name": "ansible-role-template",

  // Install dependencies via eget and the project's Python tooling.
  // @see: <https://github.com/zyedidia/eget>
  "postCreateCommand": {
    "astro": "eget -a linux_amd64 -a tar.gz --file astro --tag v1.46.0 astronomer/astro-cli",
    "backlog": "eget -a linux -a x64 MrLesk/Backlog.md",
    "bat": "eget -a x86_64-unknown-linux-gnu -a tar.gz sharkdp/bat",
    "btop": "eget -a btop-x86_64-unknown-linux-musl.tar.gz aristocratos/btop",
    "bun": "eget -a bun-linux-x64.zip -a ^profile -a ^baseline --file bun oven-sh/bun",
    // Large download (~206 MB); uncomment if you need Claude Code.
    // "claude": "eget https://downloads.claude.ai/claude-code-releases/2.1.266/linux-x64/claude",
    "dependencies": "time pip install -q -r .devcontainer/requirements.txt && time pipx install -q --include-deps --force ansible && time pipx inject -q ansible -r .devcontainer/requirements-ansible.txt && time ansible-galaxy collection install -r requirements.yml && time pre-commit install",
    "duf": "eget -a linux_x86_64.tar.gz muesli/duf",
    "eza": "eget -a x86_64-unknown-linux-gnu -a ^no_libgit -a tar.gz eza-community/eza",
    "fd": "eget -a x86_64-unknown-linux-gnu -a tar.gz sharkdp/fd",
    "glow": "eget -a Linux_x86_64.tar.gz -a ^sbom charmbracelet/glow",
    "jq": "eget -a linux64 jqlang/jq",
    "micromamba": "eget -a linux-64 -a ^sha256 -a ^tar.bz2 --to micromamba mamba-org/micromamba-releases",
    "minizinc": "eget -a bundle-linux-x86_64.tgz --tag 2.9.7 --file */bin/minizinc MiniZinc/MiniZincIDE",
    "namecom": "eget -a linux_amd64 -a tar.gz --file namecom --tag v0.5.1 patramsey/namecom-cli",
    "nono": "eget -a x86_64-unknown-linux-gnu.tar.gz nolabs-ai/nono",
    "opencode": "eget -a opencode-linux-x64.tar.gz anomalyco/opencode",
    "pandoc": "eget -a linux-amd64.tar.gz jgm/pandoc",
    "proton-drive": "eget https://proton.me/download/drive/cli/0.9.0/linux-x64/proton-drive",
    "rclone": "eget -a linux-amd64.zip --tag v1.75.1 rclone/rclone",
    "rg": "eget -a x86_64-unknown-linux-musl.tar.gz BurntSushi/ripgrep",
    "rga": "eget -a ripgrep_all -a x86_64-unknown-linux-musl -a tar.gz --file rga phiresky/ripgrep-all",
    "tealdeer": "eget -a tealdeer-linux-x86_64-musl -a ^sha256 dbrgn/tealdeer",
    "upctl": "eget -a linux_x86_64 -a tar.gz -a ^spdx --file upctl --tag v3.36.0 UpCloudLtd/upcloud-cli",
    "vale": "eget -a Linux_64-bit.tar.gz errata-ai/vale",
    "vopono": "eget -a linux_x86-64_gcc -a ^gui --to vopono jamesmcm/vopono",
    "yq": "eget -a ^.tar.gz mikefarah/yq"
  },

  // Comment out to connect as root instead. More info: https://aka.ms/vscode-remote/containers/non-root.
  "remoteUser": "vscode",
  // Note: Python dependencies can be added in the `requirements.txt` file.
  "onCreateCommand": "sudo apt-get update -qq && sudo DEBIAN_FRONTEND=noninteractive xargs -a .devcontainer/apt-packages.txt apt-get install -yqq -o Dpkg::Use-Pty=0"
}
